// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================ BLOG MODELS ================

model Post {
  id          Int        @id @default(autoincrement())
  title       String     @db.VarChar(255)
  slug        String     @unique
  excerpt     String?    @db.Text
  content     String?    @db.Text
  image       String?    @db.VarChar(500)
  category    String     @db.VarChar(100)
  status      PostStatus @default(DRAFT)
  views       Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  publishedAt DateTime?

  @@index([status])
  @@index([category])
  @@index([createdAt(sort: Desc)])
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  slug      String   @unique
  color     String?  @db.VarChar(7)
  createdAt DateTime @default(now())
}

// ================ SITE SETTINGS ================

model SiteSettings {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

// ================ PAGE CONTENT MODELS ================

model PageSection {
  id         Int      @id @default(autoincrement())
  page       PageType
  sectionKey String
  content    Json
  order      Int      @default(0)
  isActive   Boolean  @default(true)

  @@unique([page, sectionKey])
  @@index([page])
}

enum PageType {
  HOME
  ABOUT
  TEAM
  CONTACT
}

// ================ TEAM MODELS ================

model TeamMember {
  id        Int      @id @default(autoincrement())
  name      String
  role      String
  bio       String?  @db.Text
  image     String?  @db.VarChar(500)
  email     String?  @db.VarChar(255)
  phone     String?  @db.VarChar(50)
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([order])
}

// ================ TESTIMONIAL MODELS ================

model Testimonial {
  id        Int      @id @default(autoincrement())
  name      String
  role      String
  text      String   @db.Text
  image     String?  @db.VarChar(500)
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([isActive])
}

// ================ CONTACT & SOCIALS ================

model ContactInfo {
  id       Int     @id @default(autoincrement())
  key      String  @unique
  value    String  @db.Text
  label    String?
  order    Int     @default(0)
  isActive Boolean @default(true)
}

model SocialLink {
  id       Int     @id @default(autoincrement())
  platform String
  url      String  @db.VarChar(500)
  isActive Boolean @default(true)
  order    Int     @default(0)

  @@unique([platform])
}

// ================ STATS MODEL ================

model StatItem {
  id       Int     @id @default(autoincrement())
  label    String
  value    Int     @default(0)
  suffix   String?
  icon     String?
  order    Int     @default(0)
  isActive Boolean @default(true)

  @@index([order])
}

// ================ CORE VALUES ================

model CoreValue {
  id          Int     @id @default(autoincrement())
  name        String
  description String? @db.Text
  order       Int     @default(0)
  isActive    Boolean @default(true)

  @@index([order])
}

// ================ ADMIN MODEL ================

model Admin {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String
  name      String
  role      AdminRole @default(EDITOR)
  createdAt DateTime  @default(now())
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
}
